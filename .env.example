ANTHROPIC_API_KEY=sk-ant-...
SUBSTACK_PUBLICATION_URL=https://yourname.substack.com
# Preferred: cookie auth for headless runs (export connect.sid from a logged-in session)
SUBSTACK_COOKIES_PATH=/secrets/substack_cookies.json
# Fallback auth:
# SUBSTACK_EMAIL=you@example.com
# SUBSTACK_PASSWORD=...
AUTO_PUBLISH=false
OUTPUT_DIR=./output
